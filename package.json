{
  "name": "sabores-de-natal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && npm run build:client && npm run build:prerender && npm run build:check",
    "typecheck": "tsc --noEmit",
    "build:client": "vite build",
    "build:prerender": "vite build --ssr src/server.tsx --outDir .prerender && node scripts/prerender.mjs",
    "build:check": "node scripts/check-build.mjs",
    "test": "playwright test",
    "audit:mobile": "node scripts/audit-production.mjs"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dependencies": {
    "framer-motion": "^12.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "lighthouse": "^13.6.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "wrangler": "4.154.0"
  }
}
