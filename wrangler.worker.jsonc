{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Supply the existing Worker name with --name; do not create or rename it implicitly.
  "compatibility_date": "2026-10-28",
  "assets": {
    "directory": "./dist",
  },
  // Keep the dashboard Build command empty when using this custom build.
  "build": {
    "command": "npm run build",
    "cwd": ".",
  },
}
